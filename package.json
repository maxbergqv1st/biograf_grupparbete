{
  "name": "fix-for-mysql",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n fe,be -c cyan,magenta \"vite\" \"dotnet run --project backend -- 5001 .\"",
    "dev:fe": "vite",
    "dev:be": "dotnet run --project backend -- 5001 .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "be:restore": "dotnet restore backend/",
    "be:build": "dotnet build backend/",
    "be:add": "dotnet add backend/ package",
    "api:generate": "orval"
  },
